# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional public origin. Auth redirects prefer the current request / window origin.
# Do not set a *.vercel.app URL. Production fallback is https://kinetoflow.ro
# Example local: http://127.0.0.1:43123
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Email OTP (doar înregistrarea unei clinici noi — invitațiile de terapeut nu trimit OTP)
# Codul de 6 cifre NU trece prin signInWithOtp / auth.resend / mailer-ul de test Supabase.
# 1) auth.admin.generateLink mintuiește OTP-ul (fără email)
# 2) Resend emails.send livrează mesajul. Obligatoriu în producție.
# RESEND_API_KEY=re_xxxxxxxx
# SUPPORT_NOTIFY_EMAIL=kinetic01flow@gmail.com
# RESEND_FROM=KinetoFlow Suport <onboarding@resend.dev>
# RESEND_AUTH_FROM=KinetoFlow <no-reply@kinetoflow.ro>
# AUTH_OTP_PEPPER=a-long-random-string
#
# Mailer-ul built-in din Authentication → Emails e doar pentru teste (rate limit mic,
# adesea nu ajunge în inbox). Pentru recovery / template-uri Auth, pune SMTP propriu:
# Authentication → Emails → SMTP Settings
#   Resend:  host smtp.resend.com  port 465  user resend  pass = RESEND_API_KEY
#   SendGrid: host smtp.sendgrid.net port 587 user apikey pass = cheia SendGrid
#   Gmail:   host smtp.gmail.com    port 587 user adresa  pass = parolă de aplicație

# Early Access — exactly 12 characters. If unset or not 12 chars, local default is used.
# Set your own secret on Vercel. Do not reuse the local default in production.
# EARLY_ACCESS_CODE=____________
# Optional cookie signing pepper (falls back to AUTH_OTP_PEPPER / service role)
# EARLY_ACCESS_PEPPER=

# Optional Twilio SMS for patient invites (E.164, fără prefix whatsapp:) — not used for check-in reminders
# If missing, the app uses WhatsApp Click-to-Chat for invites. Reminders are FCM / Web Push only.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+4915888623971
# TWILIO_SMS_FROM=+4915888623971
# TWILIO_FROM=+4915888623971
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Firebase Cloud Messaging (web push pentru pacienți)
# Client (public):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Alias-uri acceptate: NEXT_PUBLIC_FIREBASE_SENDER_ID, NEXT_PUBLIC_FIREBASE_MESSAGING_VAPID_KEY
# Server: un singur JSON (contul de serviciu descărcat din Firebase), pe un rând.
# JSON.parse transformă \n din private_key în newline-uri — nu seta FIREBASE_PRIVATE_KEY separat.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Vercel Cron / cron-job.org — același secret, fără ghilimele în valoare
# Header: Authorization: Bearer <secret>   (sau doar <secret>)
# cron-job.org → Advanced → Request headers: Key=Authorization, Value=Bearer <secret>
# CRON_SECRET=generate-a-long-random-string
